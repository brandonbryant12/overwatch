{
  "version": 2,
  "port": 7331,
  "readings": 5,
  "redactPatterns": [
    "\\bcorp_(?:live|test)_[A-Za-z0-9]{24,}\\b",
    "\\bX-Corp-Session:\\s*[^\\s\"']+",
    "\\bsvc_tok_[A-Za-z0-9._-]{24,}\\b"
  ],
  "opencode": {
    "url": "http://127.0.0.1:4096",
    "model": "local/glm-5.3",
    "password": "keychain:overwatch/opencode",
    "concurrency": 4,
    "toolCalls": 16,
    "genUi": true
  },
  "apps": {
    "checkout": {
      "checkout": "~/src/checkout",
      "policy": {
        "readings": 3,
        "genUi": true
      },
      "problemPatterns": {
        "error": ["error", "fatal", "panic", "exception", "critical", "deadlock"],
        "warn": ["warn", "warning", "degraded", "retry"]
      },
      "commitWatch": {
        "branch": "main",
        "paths": ["config/", "db/migrations/", "src/payments/"],
        "limit": 20
      },
      "fixes": {
        "remote": "origin",
        "base": "main",
        "mode": "propose",
        "paths": ["config/payments.json", "config/database.json"],
        "verify": [["npm", "test", "--", "config"]]
      },
      "promotion": {
        "staging": "staging",
        "production": "prod-us-east"
      },
      "environments": {
        "prod-us-east": {
          "policy": {
            "critical": true,
            "investigate": true,
            "readings": 3,
            "notify": true,
            "fixMode": "propose",
            "genUi": true
          },
          "sources": {
            "pods": {
              "type": "kubernetes",
              "context": "corp-prod-us-east",
              "namespace": "checkout",
              "selector": "app=checkout",
              "readings": ["logs", "events", "workloads", "usage"]
            },
            "dd": {
              "type": "datadog",
              "baseUrl": "https://api.datadoghq.com",
              "apiKey": "keychain:overwatch/dd-api",
              "appKey": "keychain:overwatch/dd-app",
              "query": "service:checkout env:prod-us-east",
              "metric": "avg:checkout.db.disk_used{env:prod-us-east}",
              "readings": ["logs", "monitors", "metrics", "spans"],
              "spans": {
                "slowMs": 1500,
                "warnMs": 750,
                "query": "service:checkout env:prod-us-east @duration:>750000000"
              },
              "capacity": {
                "resource": "disk",
                "unit": "bytes",
                "limit": 500000000000
              }
            }
          },
          "databases": {
            "primary": {
              "driver": "postgres",
              "dsn": "env:CHECKOUT_RO_DSN",
              "allowSelect": false,
              "queries": {
                "active_locks": {
                  "sql": "SELECT pid, relation, mode, granted FROM pg_locks WHERE NOT granted LIMIT :limit",
                  "params": ["limit"]
                },
                "pool_waiters": {
                  "sql": "SELECT pid, usename, state, wait_event, query_start FROM pg_stat_activity WHERE state = 'active' AND wait_event IS NOT NULL LIMIT :limit",
                  "params": ["limit"]
                }
              }
            }
          }
        },
        "staging": {
          "policy": {
            "critical": false,
            "investigate": true,
            "readings": 2,
            "notify": false,
            "fixMode": "draft_pr",
            "genUi": true
          },
          "sources": {
            "pods": {
              "type": "kubernetes",
              "context": "corp-staging-us-east",
              "namespace": "checkout",
              "selector": "app=checkout",
              "readings": ["logs", "events", "workloads", "usage"]
            },
            "dd": {
              "type": "datadog",
              "baseUrl": "https://api.datadoghq.com",
              "apiKey": "keychain:overwatch/dd-api",
              "appKey": "keychain:overwatch/dd-app",
              "query": "service:checkout env:staging",
              "readings": ["logs", "monitors", "spans"],
              "spans": {
                "slowMs": 1200,
                "warnMs": 600,
                "query": "service:checkout env:staging"
              }
            }
          },
          "databases": {
            "staging_ro": {
              "driver": "postgres",
              "dsn": "keychain:overwatch/checkout-staging-ro-dsn",
              "allowSelect": true,
              "queries": {
                "recent_migrations": {
                  "sql": "SELECT version, applied_at FROM schema_migrations ORDER BY applied_at DESC LIMIT :limit",
                  "params": ["limit"]
                }
              }
            }
          }
        },
        "dev": {
          "policy": {
            "critical": false,
            "investigate": false,
            "notify": false,
            "fixMode": "off",
            "genUi": false
          },
          "sources": {
            "pods": {
              "type": "kubernetes",
              "context": "corp-dev-us-east",
              "namespace": "checkout-dev",
              "selector": "app=checkout",
              "readings": ["logs", "events", "workloads"]
            }
          },
          "databases": {
            "local_cache": {
              "driver": "sqlite",
              "file": "~/src/checkout/tmp/dev.sqlite",
              "allowSelect": true,
              "queries": {
                "recent_jobs": {
                  "sql": "SELECT id, status, updated_at FROM background_jobs ORDER BY updated_at DESC LIMIT :limit",
                  "params": ["limit"]
                }
              }
            }
          }
        }
      }
    }
  },
  "watchers": [
    { "app": "checkout", "environment": "prod-us-east", "every": "2m" },
    { "app": "checkout", "environment": "staging", "every": "2m" },
    { "app": "checkout", "environment": "dev", "every": "10m" }
  ]
}
