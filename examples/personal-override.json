{
  "version": 2,
  "extends": "./corp-base.json",
  "dataDir": "~/.local/share/overwatch",
  "mcpToken": "keychain:overwatch/mcp-token",
  "opencode": {
    "url": "http://127.0.0.1:4096",
    "model": "local/glm-5.3",
    "password": "keychain:overwatch/opencode",
    "concurrency": 4,
    "toolCalls": 16,
    "genUi": true
  },
  "apps": {
    "checkout": {
      "checkout": "~/Development/checkout",
      "environments": {
        "prod-us-east": {
          "policy": {
            "readings": 5
          },
          "databases": {
            "primary": {
              "dsn": "keychain:overwatch/checkout-ro-dsn"
            }
          }
        },
        "dev": {
          "databases": {
            "local_cache": {
              "file": "~/Development/checkout/tmp/dev.sqlite"
            }
          }
        }
      }
    }
  },
  "watchers": [
    { "app": "checkout", "environment": "prod-us-east", "every": "2m" },
    { "app": "checkout", "environment": "staging", "every": "2m" }
  ]
}
