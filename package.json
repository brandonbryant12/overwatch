{
  "name": "overwatch",
  "version": "2.0.0",
  "description": "Overwatch: one local process that watches Kubernetes and Datadog, counts exactly inside declared limits, and investigates with OpenCode. Built on Effect.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.16 <23 || >=24"
  },
  "bin": {
    "overwatch": "./bin/overwatch"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts web/test/*.test.ts",
    "check": "pnpm run typecheck && pnpm test",
    "accept": "node --no-warnings --test --test-concurrency=2 accept/m1/*.test.mjs",
    "build:web": "node --experimental-strip-types --no-warnings scripts/build-web.ts",
    "prepare": "node --experimental-strip-types --no-warnings scripts/build-web.ts --optional"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.5",
    "@effect/platform-node": "4.1.5",
    "@effect/sql-sqlite-node": "4.1.5",
    "effect": "4.1.5",
    "foldkit": "0.171.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.2",
    "rolldown": "1.3.3",
    "typescript": "^5.8.2"
  }
}
