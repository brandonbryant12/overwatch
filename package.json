{
  "name": "opencode-overwatch",
  "version": "0.2.0",
  "description": "OpenCode 2 plugin that watches your apps' logs and telemetry since it last checked, opens incidents, investigates them with agents, and reports tersely.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "prompts",
    "examples",
    "docs",
    "README.md",
    "AGENTS.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "observability",
    "kubernetes",
    "datadog",
    "incident"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm test",
    "build": "tsc -p tsconfig.build.json",
    "smoke": "node --experimental-strip-types scripts/smoke.ts"
  },
  "devDependencies": {
    "@opencode/client": "2.4.1",
    "@opencode/plugin": "2.4.1",
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@alchemy.run/domain": "2.0.0-beta.87",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.5"
  }
}
