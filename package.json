{
  "name": "overwatch",
  "version": "2.0.0",
  "description": "Overwatch: one local process that watches Kubernetes and Datadog, counts exactly inside declared limits, and investigates with OpenCode.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "overwatch": "./bin/overwatch"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "check": "pnpm run typecheck && pnpm test",
    "accept": "node --no-warnings --test --test-concurrency=2 accept/m1/*.test.mjs"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.6",
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@fab0fba",
    "@effect/ui-kit": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-kit@fab0fba",
    "effect": "4.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.2",
    "rolldown": "1.3.3",
    "typescript": "^5.8.2"
  }
}
